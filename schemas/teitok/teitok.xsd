<?xml version="1.0" encoding="UTF-8"?>
<!--
  schemas/teitok/teitok.xsd

  Output contract for `.teitok.xml` files produced by
  api_util/teitok_alto.py (write_teitok_merged), "TEITOK format 2"
  (<application ident="atrium-nlp-enrich" version="teitok-2">). This is NOT
  a full upstream TEI/TEITOK schema: none exists (flexiconv, flexipipe,
  teitok-tools and xmltokenizer ship no XSD/RNG/DTD). It is a minimal,
  purpose-built schema for exactly the subset of TEI this pipeline emits, so
  that api_util/validate_teitok_xml.py can catch generator regressions
  (malformed attributes, dropped required elements, broken nesting) before
  packaging. Conformance with the upstream tools' *conventions* (spacing,
  multi-word tokens, ids) is checked by tests/test_teitok_conformance.py,
  which reads the writer's output the way those tools do; see README.md.

  Backward compatible with format-1 documents (older data_samples, resumed
  runs): legacy ids, `<div type="MarginTextZone-P">`, `xml:lang`, the TEI
  namespace, `<name>` without `@id` all still validate. What no longer
  validates is a negative bbox coordinate.

  The opt-in record projection (api_util/teitok_project.py, atrium-project#70)
  adds, additively and only in the header plus `pb/@ana`: `encodingDesc/classDecl`
  (taxonomies of page categories and keyword schemes), `application/@id`,
  `profileDesc/textClass/keywords/term`, and a `change` of type "enriched".
  A document without them validates exactly as before.

  NO TARGET NAMESPACE — this is deliberate, not an oversight.
  write_teitok_merged() emits `<TEI xmlnsoff="http://www.tei-c.org/ns/1.0">`:
  `xmlnsoff`, not `xmlns`. That is TEITOK's own convention for keeping
  documents out of the TEI namespace so TEITOK's tooling can address elements
  unprefixed. So real documents are namespace-less, `xmlnsoff` and `lang` are
  ordinary attributes (declared on <TEI> below — an undeclared attribute is a
  validation error), and this schema declares its elements in no namespace to
  match. Documents that DO carry the TEI namespace (older exports, output of
  service/rescale.py, which preserves whatever its input declared) are
  normalized by api_util/validate_teitok_xml.py, which strips the TEI
  namespace before validating, so one schema covers both conventions.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xml="http://www.w3.org/XML/1998/namespace">

  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="xml.xsd"/>

  <!-- ═══════════════════════ Root ═══════════════════════ -->
  <xs:element name="TEI">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="teiHeader"/>
        <xs:element ref="facsimile" minOccurs="0"/>
        <xs:element ref="text"/>
      </xs:sequence>
      <!-- The writer's literal attributes. `xmlnsoff` carries the TEI
           namespace URI as a plain string; `lang` is the unprefixed ISO 639-1
           code (omitted when neither ALTO nor the UDPipe model names one).
           `xml:lang` is accepted too, for namespace-stripped documents that
           used the standard spelling. -->
      <xs:attribute name="xmlnsoff" type="xs:string" use="optional"/>
      <xs:attribute name="lang" type="xs:string" use="optional"/>
      <xs:attribute ref="xml:lang" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ teiHeader ═══════════════════════ -->
  <xs:element name="teiHeader">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="fileDesc"/>
        <xs:element ref="encodingDesc" minOccurs="0"/>
        <xs:element ref="profileDesc" minOccurs="0"/>
        <xs:element ref="revisionDesc" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="fileDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="titleStmt"/>
        <xs:element ref="publicationStmt"/>
        <xs:element ref="notesStmt" minOccurs="0"/>
        <xs:element ref="sourceDesc"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="titleStmt">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="title"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="title" type="xs:string"/>

  <xs:element name="publicationStmt">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="p" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- `<note n="orgfile">` names the file the document was converted from,
       as TEITOK and flexiconv record it. -->
  <xs:element name="notesStmt">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="note" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="note">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="n" type="xs:string" use="optional"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="sourceDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="p" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="p" type="xs:string"/>

  <xs:element name="encodingDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="appInfo"/>
        <xs:element ref="classDecl" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="appInfo">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="application" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="application">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="label"/>
        <xs:element ref="desc" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="ident" type="xs:string" use="required"/>
      <xs:attribute name="version" type="xs:string" use="optional"/>
      <!-- "app-…": an application the record projection names in keywords/@resp. -->
      <xs:attribute name="id" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="label" type="xs:string"/>
  <xs:element name="desc" type="xs:string"/>

  <!-- ═══════════ Record projection (opt-in, api_util/teitok_project.py) ═══════════ -->
  <!-- Taxonomies the projection points at: the page categories pb/@ana names
       (category/@corresp = the atrium_vocab concept URI), the AMČR/TEATER
       vocabulary and a statistical keyword method (keywords/@scheme). -->
  <xs:element name="classDecl">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="taxonomy" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="taxonomy">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="desc" minOccurs="0"/>
        <xs:element ref="category" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="category">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="catDesc" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="corresp" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="catDesc">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="lang" type="xs:string" use="optional"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="profileDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="langUsage" minOccurs="0"/>
        <xs:element ref="textClass" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- One keywords list per source: @resp names the application, @scheme the
       taxonomy, @lang the language of controlled keywords, and @corresp the page
       a per-page statistical list belongs to. -->
  <xs:element name="textClass">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="keywords" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="keywords">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="term" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="scheme" type="xs:string" use="optional"/>
      <xs:attribute name="resp" type="xs:string" use="optional"/>
      <xs:attribute name="lang" type="xs:string" use="optional"/>
      <xs:attribute name="corresp" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <!-- @type: teater-category | extracted-keyword | statistical-keyword; @ref: concept
       URIs; @cert: the category's confidence in [0, 1]; @score: a statistical method's
       score (a TEITOK-style attribute, like @bbox); @n: the rank; @corresp: the pages. -->
  <xs:element name="term">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="type" type="xs:string" use="optional"/>
          <xs:attribute name="ref" type="xs:string" use="optional"/>
          <xs:attribute name="cert" type="probabilityType" use="optional"/>
          <xs:attribute name="score" type="xs:double" use="optional"/>
          <xs:attribute name="corresp" type="xs:string" use="optional"/>
          <xs:attribute name="n" type="xs:string" use="optional"/>
          <xs:attribute name="lang" type="xs:string" use="optional"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="langUsage">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="language" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="language">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="ident" type="xs:string" use="required"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="revisionDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="change" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- @type/@subtype name the workflow phase (converted, tagged/parsed, ner)
       the way TEITOK/flexicorp read revisionDesc. -->
  <xs:element name="change">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="when" type="xs:string" use="required"/>
          <xs:attribute name="who" type="xs:string" use="required"/>
          <xs:attribute name="type" type="xs:string" use="optional"/>
          <xs:attribute name="subtype" type="xs:string" use="optional"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ facsimile ═══════════════════════ -->
  <xs:element name="facsimile">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="surface" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- lrx/lry: the extent of the coordinate space every bbox on this page is
       expressed in (page image, or PrintSpace under BBOX_ORIGIN=printspace). -->
  <xs:element name="surface">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="graphic"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="lrx" type="xs:integer" use="optional"/>
      <xs:attribute name="lry" type="xs:integer" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="graphic">
    <xs:complexType>
      <xs:attribute name="url" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ text / body ═══════════════════════ -->
  <xs:element name="text">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="body"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    Body is a flat, repeatable mix of page breaks, non-text figures, and
    text-zone divs. teitok_alto.py emits these in document order but not
    in a fixed 1:1 grouping (a page can have zero or many figures; a div
    can span or restart within a page boundary), so we model it as a
    repeatable choice rather than a strict pb->figure*->div* sequence.
  -->
  <xs:element name="body">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="pb"/>
        <xs:element ref="figure"/>
        <xs:element ref="div"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- A page break. It may sit inside <s> and <name> too: a sentence (or an
       entity) that runs over a page break keeps its tokens together, and the
       <pb/> comes before the first token of the new page: the anchor
       xmltokenizer and flexiconv allow there. @n is the page label (a number,
       or e.g. "I"); @facs, @corresp ("#facs-P") and @bbox ("0 0 W H", the
       page extent, as flexiconv writes it for hOCR/PDF) appear only when the
       page has a <surface>: a page of a text-only document has no image. -->
  <xs:element name="pb">
    <xs:complexType>
      <xs:attribute name="n" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="facs" type="xs:string" use="optional"/>
      <xs:attribute name="corresp" type="xs:string" use="optional"/>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
      <!-- "#pcat-…": the page's category (record projection, opt-in). -->
      <xs:attribute name="ana" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="figure">
    <xs:complexType>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bbox" type="bboxType" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- @type: "TextBlock" (an ALTO TextBlock), "text" (no ALTO block to follow),
       or a legacy value; @subtype: the LABEL of the block's ALTO TAGREFS tag;
       @lang: only where the block's ALTO LANG differs from the document's. -->
  <xs:element name="div">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="s" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="subtype" type="xs:string" use="optional"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="lang" type="xs:string" use="optional"/>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!--
    <s> is a run of line-breaks, plain tokens, and named-entity spans in
    the order the tokenizer/NER pass produced them. The whitespace between
    them is significant to TEITOK readers (whitespace = a space, none =
    SpaceAfter=No) and is allowed by this element-only content model.
  -->
  <xs:element name="s">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="pb"/>
        <xs:element ref="lb"/>
        <xs:element ref="tok"/>
        <xs:element ref="name"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="text" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="lb">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Named-entity span: a run of (optional line-breaks +) tokens.
       @type is the coarse class; the raw NameTag label goes in the attribute
       of its tagset: @cnec (CNEC 2.0), @onto (OntoNotes 5), @archaeo (the
       archaeological model), @label (unknown). @sameAs lists the tokens. -->
  <xs:element name="name">
    <xs:complexType>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="pb"/>
        <xs:element ref="lb"/>
        <xs:element ref="tok"/>
      </xs:choice>
      <!-- @id is optional: format-1 exports carry bare
           `<name type="MISC" cnec="ty">`, and those are legitimate documents
           the gate must accept. -->
      <xs:attribute name="id" type="xs:string" use="optional"/>
      <xs:attribute name="type" type="nerCategoryType" use="required"/>
      <xs:attribute name="cnec" type="xs:string" use="optional"/>
      <xs:attribute name="onto" type="xs:string" use="optional"/>
      <xs:attribute name="archaeo" type="xs:string" use="optional"/>
      <xs:attribute name="label" type="xs:string" use="optional"/>
      <xs:attribute name="sameAs" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Surface token. Its text is the surface form; a multi-word token adds
       one <dtok> per syntactic word ("abych" = aby + bych). -->
  <xs:element name="tok">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element ref="dtok" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="type" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="w"/>
            <xs:enumeration value="pc"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="wordAttributes"/>
      <xs:attribute name="join" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="right"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Syntactic word of a multi-word token. -->
  <xs:element name="dtok">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="form" type="xs:string" use="optional"/>
      <xs:attributeGroup ref="wordAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ Shared types ═══════════════════════ -->

  <!-- CoNLL-U columns as TEITOK attributes. @ord is the sentence-local word
       index (CoNLL-U ID); @head is the @id of the head word. -->
  <xs:attributeGroup name="wordAttributes">
    <xs:attribute name="ord" type="xs:string" use="optional"/>
    <xs:attribute name="lemma" type="xs:string" use="optional"/>
    <xs:attribute name="upos" type="xs:string" use="optional"/>
    <xs:attribute name="xpos" type="xs:string" use="optional"/>
    <xs:attribute name="feats" type="xs:string" use="optional"/>
    <xs:attribute name="head" type="xs:string" use="optional"/>
    <xs:attribute name="deprel" type="xs:string" use="optional"/>
  </xs:attributeGroup>

  <!-- "x1 y1 x2 y2", non-negative integer pixel coordinates, as written by
       api_util/teitok_alto.py (which clamps anything outside the page or
       PrintSpace to 0). -->
  <xs:simpleType name="bboxType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+ \d+ \d+ \d+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A probability, TEI teidata.probability. -->
  <xs:simpleType name="probabilityType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Coarse entity class, api_util/ner_types.py::coarse_type(). -->
  <xs:simpleType name="nerCategoryType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PER"/>
      <xs:enumeration value="ORG"/>
      <xs:enumeration value="LOC"/>
      <xs:enumeration value="MISC"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
