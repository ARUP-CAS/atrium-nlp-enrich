<?xml version="1.0" encoding="UTF-8"?>
<!--
  schemas/teitok/teitok.xsd

  Output contract for `.teitok.xml` files produced by
  api_util/teitok_alto.py (write_teitok_merged). This is NOT the full
  upstream TEI/TEITOK schema — it is a minimal, purpose-built schema that
  describes exactly the subset of TEI this pipeline emits, so that
  api_util/validate_teitok_xml.py can catch generator regressions
  (malformed attributes, dropped required elements, broken nesting)
  before packaging.

  Provenance: hand-authored against the real output of
  api_util/teitok_alto.py::write_teitok_merged(). Not sourced from
  teitok.org — this pipeline's TEITOK XML is a constrained subset/profile
  of TEI, and no single canonical upstream .xsd covers this exact profile.
  If TEITOK later publishes an authoritative schema for this profile,
  prefer vendoring that instead of this hand-authored one.

  NO TARGET NAMESPACE — this is deliberate, not an oversight.
  write_teitok_merged() emits `<TEI xmlnsoff="http://www.tei-c.org/ns/1.0"
  lang="cs">`: `xmlnsoff`, not `xmlns`. That is TEITOK's own convention for
  keeping documents out of the TEI namespace so TEITOK's tooling can address
  elements unprefixed, and it has been the writer's output since the file was
  added. So real documents are namespace-less, `xmlnsoff` and `lang` are
  ordinary attributes (declared on <TEI> below — an undeclared attribute is a
  validation error), and this schema declares its elements in no namespace to
  match. Documents that DO carry the TEI namespace (older exports, output of
  service/rescale.py, which preserves whatever its input declared) are
  normalized by api_util/validate_teitok_xml.py, which strips the TEI
  namespace before validating, so one schema covers both conventions.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xml="http://www.w3.org/XML/1998/namespace">

  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="xml.xsd"/>

  <!-- ═══════════════════════ Root ═══════════════════════ -->
  <xs:element name="TEI">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="teiHeader"/>
        <xs:element ref="facsimile" minOccurs="0"/>
        <xs:element ref="text"/>
      </xs:sequence>
      <!-- The writer's literal attributes. `xmlnsoff` carries the TEI
           namespace URI as a plain string; `lang` is the unprefixed language
           code. `xml:lang` is accepted too, for namespace-stripped documents
           that used the standard spelling. -->
      <xs:attribute name="xmlnsoff" type="xs:string" use="optional"/>
      <xs:attribute name="lang" type="xs:string" use="optional"/>
      <xs:attribute ref="xml:lang" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ teiHeader ═══════════════════════ -->
  <xs:element name="teiHeader">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="fileDesc"/>
        <xs:element ref="encodingDesc" minOccurs="0"/>
        <xs:element ref="revisionDesc" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="fileDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="titleStmt"/>
        <xs:element ref="publicationStmt"/>
        <xs:element ref="sourceDesc"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="titleStmt">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="title"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="title" type="xs:string"/>

  <xs:element name="publicationStmt">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="p" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="sourceDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="p" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="p" type="xs:string"/>

  <xs:element name="encodingDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="appInfo"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="appInfo">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="application" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="application">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="label"/>
        <xs:element ref="desc" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="ident" type="xs:string" use="required"/>
      <xs:attribute name="version" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="label" type="xs:string"/>
  <xs:element name="desc" type="xs:string"/>

  <xs:element name="revisionDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="change" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="change">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="when" type="xs:string" use="required"/>
          <xs:attribute name="who" type="xs:string" use="required"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ facsimile ═══════════════════════ -->
  <xs:element name="facsimile">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="surface" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="surface">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="graphic"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="lrx" type="xs:integer" use="optional"/>
      <xs:attribute name="lry" type="xs:integer" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="graphic">
    <xs:complexType>
      <xs:attribute name="url" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ text / body ═══════════════════════ -->
  <xs:element name="text">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="body"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--
    Body is a flat, repeatable mix of page breaks, non-text figures, and
    text-zone divs. teitok_alto.py emits these in document order but not
    in a fixed 1:1 grouping (a page can have zero or many figures; a div
    can span or restart within a page boundary), so we model it as a
    repeatable choice rather than a strict pb->figure*->div* sequence.
  -->
  <xs:element name="body">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="pb"/>
        <xs:element ref="figure"/>
        <xs:element ref="div"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="pb">
    <xs:complexType>
      <xs:attribute name="n" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="facs" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="figure">
    <xs:complexType>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bbox" type="bboxType" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="div">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="s" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!--
    <s> is a run of line-breaks, plain tokens, and named-entity spans in
    the order the tokenizer/NER pass produced them.
  -->
  <xs:element name="s">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="lb"/>
        <xs:element ref="tok"/>
        <xs:element ref="name"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="text" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="lb">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="bbox" type="bboxType" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Named-entity span: a run of (optional line-breaks +) tokens. -->
  <xs:element name="name">
    <xs:complexType>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="lb"/>
        <xs:element ref="tok"/>
      </xs:choice>
      <!-- @id is optional: the current writer emits it (teitok_alto.py:848),
           but older exports in data_samples/TEITOK/ carry bare
           `<name type="MISC" cnec="ty">`, and those are legitimate documents
           the gate must accept. -->
      <xs:attribute name="id" type="xs:string" use="optional"/>
      <xs:attribute name="type" type="nerCategoryType" use="required"/>
      <xs:attribute name="cnec" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tok">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="type" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="w"/>
                <xs:enumeration value="pc"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="lemma" type="xs:string" use="optional"/>
          <xs:attribute name="upos" type="xs:string" use="optional"/>
          <xs:attribute name="xpos" type="xs:string" use="optional"/>
          <xs:attribute name="feats" type="xs:string" use="optional"/>
          <xs:attribute name="head" type="xs:string" use="optional"/>
          <xs:attribute name="deprel" type="xs:string" use="optional"/>
          <xs:attribute name="join" use="optional">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="right"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="bbox" type="bboxType" use="optional"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <!-- ═══════════════════════ Shared types ═══════════════════════ -->

  <!-- "x1 y1 x2 y2" absolute pixel coordinates, as written by
       api_util/bbox_scale.py::scale_bbox_coords(). -->
  <xs:simpleType name="bboxType">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+ -?\d+ -?\d+ -?\d+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- CoNLL-style category emitted via _CNEC_TO_CONLL in teitok_alto.py. -->
  <xs:simpleType name="nerCategoryType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PER"/>
      <xs:enumeration value="ORG"/>
      <xs:enumeration value="LOC"/>
      <xs:enumeration value="MISC"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
